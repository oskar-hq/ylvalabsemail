# ─── Mailserver (Postausgang) ──────────────────────────────────────────
# Beispiele: smtp.strato.de / smtp.ionos.de / smtp.office365.com / smtp.gmail.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (Port 587) | ssl (Port 465) | none (nur im internen Netz)
SMTP_SECURITY=starttls

# Nur nötig, wenn der Benutzername KEINE E-Mail-Adresse ist:
# FROM_ADDRESS=hallo@ylvalabs.de

# Wer sich anmelden darf. Ohne diese Angaben kann sich jedes Postfach anmelden,
# das der Mailserver akzeptiert. Für den Betrieb im Internet unbedingt setzen!
# Alle Postfächer der Firmen-Domain:
ALLOWED_DOMAINS=ylvalabs.de
# und/oder einzelne Adressen (Komma-getrennt):
# ALLOWED_USERS=info@ylvalabs.de

# ─── Kopie im Ordner „Gesendet“ (optional, IMAP) ──────────────────────
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# Leer lassen = automatisch erkennen
# IMAP_SENT_FOLDER=Sent

# ─── Vorbelegungen im Formular ────────────────────────────────────────
ORG_NAME=Ylva Labs
DEFAULT_SENDER_NAME=
DEFAULT_FOOTER=Ylva Labs · Musterstraße 1 · 24103 Kiel · Schleswig-Holstein
# DEFAULT_CLOSING=Ihr habt ein Problem, das nervt, oder eine Idee, die raus will? Antwortet einfach auf diese Mail.

# ─── Versand ──────────────────────────────────────────────────────────
# Pause zwischen zwei Mails in Sekunden (schont das Versandlimit des Providers)
SEND_DELAY=1
MAX_RECIPIENTS=200

# ─── Demo-Modus ───────────────────────────────────────────────────────
# true = Knopf „Demo ansehen“ auf der Anmeldeseite: alles ausprobieren, ohne Postfach,
# es wird nichts verschickt. Vor dem Betrieb im Internet wieder auf false setzen!
DEMO_MODE=false

# ─── Sicherheit ───────────────────────────────────────────────────────
# Wird beim ersten Start automatisch erzeugt, wenn leer.
SECRET_KEY=
# Auf true setzen, sobald die App über HTTPS erreichbar ist (z. B. Cloudflare Tunnel)
COOKIE_SECURE=false
# Läuft die App hinter einem Proxy, hier angeben, damit die Sperre nach Fehlversuchen
# die echte Besucher-IP sieht: none | cloudflare | proxy
TRUST_PROXY=none
# Nach wie vielen Stunden man sich neu anmelden muss
SESSION_HOURS=12

# ─── KI-Akquise (Bereich „Leads“) ─────────────────────────────────────
# Schlüssel aus der Anthropic Console (console.anthropic.com → API Keys). Ohne Schlüssel wird nichts recherchiert.
ANTHROPIC_API_KEY=
# Die KI arbeitet in Stufen, von günstig nach stark. Nur wer eine Stufe besteht, kommt in die nächste:
#   Vorprüfung der Startseite  → AI_MODEL_QUICK   (günstig, sieht sich viele Betriebe an)
#   Analyse mit Unterseiten    → AI_MODEL_ANALYSE (mittel, nur die Besten; liest auch Antworten, lernt)
#   Entwurf und Chat           → AI_MODEL         (stark, nur die Allerbesten)
AI_MODEL_QUICK=claude-haiku-4-5
AI_MODEL_ANALYSE=claude-sonnet-5
AI_MODEL=claude-opus-5
# Denk-Aufwand (low | medium | high): weniger = günstiger, aber oberflächlicher
AI_EFFORT_ANALYSE=medium
AI_EFFORT=high
# Umrechnung der Dollar-Preise von Anthropic in Euro (gelegentlich anpassen)
EUR_PER_USD=0.86

# Eigenes Postfach für die Akquise, z. B. kontakt@ylvalabs.de. Darüber gehen freigegebene Mails raus,
# und dort liest die KI die Antworten der Firmen (dafür muss IMAP_HOST oben gesetzt sein).
OUTREACH_USER=
OUTREACH_PASSWORD=
# Erstkontakt per Mail erst einschalten, wenn ihr das rechtlich geklärt habt (§ 7 UWG, siehe README).
# Solange false: freigegebene Nachrichten als Brief drucken oder fürs Telefonat nutzen.
OUTREACH_EMAIL=false

# Wer bekommt Benachrichtigungen per Mail (zusätzlich zur Push-Nachricht aufs Handy)?
NOTIFY_EMAILS=oskar@ylvalabs.de
# Adresse, unter der die App erreichbar ist (für Links in den Benachrichtigungen)
BASE_URL=https://mail.ylvalabs.de

# Suchgebiet: Mittelpunkt (Breite,Länge) und Radius. Standard: Kappeln, 50 km.
LEADS_CENTER=54.6614,9.9311
LEADS_RADIUS_KM=50
# Die KI läuft nie von selbst. Ihr startet jeden Lauf in der Oberfläche; das hier sind nur die Vorschläge im Start-Dialog.
LEADS_RUN_CHECK=30
LEADS_RUN_DRAFTS=5
LEADS_RUN_BUDGET_EUR=2
# Harte Grenze pro Kalendermonat für alle KI-Kosten zusammen (0 = keine Grenze)
LEADS_MONTHLY_BUDGET_EUR=20
# Mindestpunktzahl, um in die nächste Stufe zu kommen (0–100)
LEADS_QUICK_MIN=50
LEADS_ANALYSE_MIN=65
# Unterschrift unter den Akquise-Nachrichten
LEADS_SENDER_NAME=Oskar Jacobsen
# Wie oft das Postfach auf Antworten geprüft wird (Minuten)
INBOX_MINUTES=10
# false schaltet den Hintergrund-Arbeiter ab (die Oberfläche bleibt nutzbar)
LEADS_WORKER=true
