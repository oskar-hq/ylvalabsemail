[Unit]
Description=Ylva Labs Mailer
After=network-online.target
Wants=network-online.target

[Service]
User=mailer
WorkingDirectory=/opt/ylva-mailer
EnvironmentFile=/opt/ylva-mailer/.env
Environment=DATA_DIR=/opt/ylva-mailer/data
ExecStart=/opt/ylva-mailer/.venv/bin/gunicorn --workers 1 --threads 8 --timeout 600 --bind 0.0.0.0:8080 app.main:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
